# Google Gemini API Configuration (Default - Zero-Cost Free Tier)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Configuration (Optional Alternative)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# GitHub Configuration (Automatically provided in GitHub Actions as GITHUB_TOKEN)
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPOSITORY=owner/repo
GITHUB_PULL_REQUEST_NUMBER=1

# Reviewer Settings
AI_REVIEWER_CONFIG_PATH=.ai-reviewer.yml
AI_REVIEWER_DRY_RUN=false
AI_REVIEWER_LOG_LEVEL=INFO
